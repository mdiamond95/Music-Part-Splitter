{
  "name": "part-splitter",
  "version": "1.0.0",
  "private": true,
  "description": "Verification harness for index.html. The web app itself needs no build step.",
  "scripts": {
    "map": "node tools/map.mjs",
    "check": "node tools/checks.mjs",
    "export": "node tools/export.mjs",
    "stamp": "node tools/stamp.mjs",
    "hooks": "git config core.hooksPath .githooks && echo \"hooks installed: .githooks\"",
    "diagnose": "node tools/diagnose.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "3.11.174",
    "pdf-lib": "1.17.1"
  }
}
